#!/bin/sh
# zavet — repo-local knowledge layer helper (decisions, guards, trailers).
#
# POSIX sh. Hard dependencies: git, awk, sed. `dira` is optional — every
# integration point degrades to a no-op when it is absent.
set -u

ZAVET_DIR=".zavet"
MARK_START="<!-- zavet:decisions:start -->"
MARK_END="<!-- zavet:decisions:end -->"
MARK_SPECS_START="<!-- zavet:specs:start -->"
MARK_SPECS_END="<!-- zavet:specs:end -->"
# The `zavet version --json` contract — bump ZAVET_EMIT_SCHEMA when the
# `emit` payload shape changes; ZAVET_MIN_DIRA is advisory only (see
# cmd_version — dira never gates on it, it only surfaces skew).
ZAVET_EMIT_SCHEMA=1
ZAVET_MIN_DIRA="0.1.0"

usage() {
    cat <<'EOF'
zavet — repo-local knowledge layer (decisions, guards, trailers)

Usage:
  zavet init                  Scaffold .zavet/ in the current git repo
  zavet root                  Print repo toplevel (fails unless .zavet/ exists)
  zavet next-id               Print the next decision id (D-NNNN)
  zavet list                  Print TAB-separated: id, status, title
  zavet guards                Print TAB-separated: id, guard glob (active only)
  zavet match <path>          Print ids of active decisions guarding <path>
                              (<path> is relative to the repo toplevel)
  zavet match-batch           Read repo-relative paths (one per line) on stdin,
                              print unique ids of active decisions guarding them
  zavet decision-path <id>    Print the repo-relative path of a decision file
  zavet specs                 Print TAB-separated: slug, origin, confidence, date, title
  zavet spec-paths            Print TAB-separated: slug, path glob (every spec)
  zavet checks                Print TAB-separated: id, label, command (every status)
  zavet spec-checks           Print TAB-separated: slug, label, command
  zavet errata                Print TAB-separated: id, corrected-by
  zavet section <id> <head>   Print one "## <head>" section of a decision body
  zavet verify [--id D-NNNN] [--spec <slug>] [--paths f...] [--grep <substr>]
                              RUN the checks bound to matching records and
                              report PASS/FAIL (exit 1 if any failed). Runs
                              shell commands read from the repo — never wired
                              into a hook, only an explicit invocation.
  zavet spec-match            Read repo-relative paths (one per line) on stdin,
                              print unique slugs of specs whose paths cover them
  zavet check <rev-range>     CI floor: fail if commits in the range touch
                              guarded paths without a Refs:/Supersedes:
                              trailer; warn on spec-covered paths without a
                              Spec: trailer (exit 1 only on violations)
  zavet audit                 Report stale specs, stale decisions, and guard
                              pressure as TAB-separated rows (report-only)
  zavet index                 Regenerate the decisions + specs blocks of .zavet/INDEX.md
  zavet deny <reason>         Print a PreToolUse permission-deny JSON (for hooks)
  zavet emit <kind> <id> [file]
                              Fire a guard event to dira (silent no-op without dira)
  zavet version [--json]      Print the plugin version (bare, or as a JSON contract)
EOF
}

die() {
    printf 'zavet: %s\n' "$1" >&2
    exit 1
}

script_dir() {
    # shellcheck disable=SC1007
    CDPATH= cd -- "$(dirname -- "$0")" && pwd
}

# Read the "version" field out of the plugin manifest via sed/awk only — jq
# is a soft dependency of the hooks (see header), never of this script.
# Never fails: prints "unknown" for a missing or unparseable manifest.
plugin_version() {
    manifest="$(script_dir)/../.claude-plugin/plugin.json"
    [ -f "$manifest" ] || { printf 'unknown\n'; return 0; }
    v=$(awk -F'"' '
        /^[ \t]*"version"[ \t]*:/ { print $4; exit }
    ' "$manifest" 2>/dev/null)
    if [ -n "$v" ]; then
        printf '%s\n' "$v"
    else
        printf 'unknown\n'
    fi
}

repo_toplevel() {
    git rev-parse --show-toplevel 2>/dev/null
}

# Toplevel of the repo that actually carries .zavet/ — or fail.
zavet_root() {
    top=$(repo_toplevel) || die "not inside a git repository"
    [ -d "$top/$ZAVET_DIR" ] || die "no $ZAVET_DIR/ in $top (run: zavet init)"
    printf '%s\n' "$top"
}

# Parse decision-file frontmatter — MANY files in a single awk pass.
# Per-file state resets on FNR == 1; because `status:` may appear after
# `guards:` in the frontmatter, guards buffer per file and flush on file
# change / END (exactly what the old per-file END did).
#   frontmatter meta   FILE...  -> "id<TAB>status<TAB>title" (one line per file)
#   frontmatter guards FILE...  -> "id<TAB>glob" (active decisions only)
#   frontmatter checks FILE...  -> "id<TAB>label<TAB>command" (EVERY status:
#       a check claims how a record was verified, which stays true after
#       supersession — unlike a guard, which enforces nothing once superseded)
#   frontmatter errata FILE...  -> "id<TAB>corrected-by" (only records with one)
frontmatter() {
    mode=$1
    shift
    [ $# -gt 0 ] || return 0
    awk -v mode="$mode" '
        # Inline `# comments` are allowed on structured lines — NEVER on
        # title, which is free text. Same dialect as dira-core::zavet.
        function decomment(s) {
            if (s ~ /^#/) return ""
            if (s !~ /^["'\'']/) sub(/[ \t]+#.*$/, "", s)
            return s
        }
        # Split a check item on its FIRST "::" into _lbl/_cmd. No separator
        # means the item IS the command and doubles as its own label; only the
        # first separator splits, so a command keeps any later "::".
        # Strip ONE matching pair of surrounding quotes, like the Rust
        # unquote. Deliberately not the independent-gsub form the guard and
        # path lists use: a command ending in a quote (runner --grep "A::b")
        # would lose it. sprintf(%c,34/39) keeps the quotes out of the awk
        # source, which lives inside a single-quoted shell string.
        function unpair(v,    f, l, dq, sq) {
            dq = sprintf("%c", 34); sq = sprintf("%c", 39)
            if (length(v) < 2) return v
            f = substr(v, 1, 1); l = substr(v, length(v), 1)
            if (f == l && (f == dq || f == sq)) return substr(v, 2, length(v) - 2)
            return v
        }
        function splitcheck(s,    i) {
            i = index(s, "::")
            if (i > 0) { _lbl = substr(s, 1, i - 1); _cmd = substr(s, i + 2) }
            else { _lbl = s; _cmd = s }
            gsub(/^[ \t]+/, "", _lbl); gsub(/[ \t]+$/, "", _lbl)
            gsub(/^[ \t]+/, "", _cmd); gsub(/[ \t]+$/, "", _cmd)
            if (_lbl == "") _lbl = _cmd
        }
        function flush(    i) {
            # `closed` gates emission: an unclosed --- fence is malformed and
            # yields nothing, matching the Rust parser.
            if (id != "" && closed) {
                if (status == "") status = "active"
                if (mode == "meta") print id "\t" status "\t" title
                else if (mode == "errata") {
                    # Verbatim, NOT canonicalized — id canonicalization is a
                    # documented Rust-only extra (see the fixtures README).
                    if (correctedby != "") print id "\t" correctedby
                }
                else if (mode == "checks") {
                    for (i = 1; i <= nc; i++) {
                        splitcheck(checks[i])
                        # A label with no command verifies nothing.
                        if (_cmd != "") print id "\t" _lbl "\t" _cmd
                    }
                }
                else if (mode == "guards" && status == "active")
                    for (i = 1; i <= ng; i++) print id "\t" guards[i]
            }
            id = ""; status = ""; title = ""; ng = 0; nc = 0; correctedby = ""
            fm = 0; done = 0; closed = 0; inguards = 0; inchecks = 0
        }
        FNR == 1 { flush(); if ($0 == "---") fm = 1; else done = 1; next }
        done { next }
        fm && /^---[ \t]*$/ { done = 1; closed = 1; next }
        # Block-list discipline mirrors the Rust walker: a `- item` line
        # (any indentation, space/tab after the dash) extends the list;
        # other indented lines under it are tolerated and skipped; the
        # first non-indented non-item line ENDS the list and is then
        # parsed normally (so a key after the list terminates it).
        inguards && /^[ \t]*-[ \t]/ {
            g = $0; sub(/^[ \t]*-[ \t][ \t]*/, "", g)
            g = decomment(g)
            sub(/[ \t]+$/, "", g)
            gsub(/^["'\'']/, "", g); gsub(/["'\''][ \t]*$/, "", g)
            if (g != "") guards[++ng] = g
            next
        }
        inguards && /^[ \t]+[^ \t]/ { next }
        inguards { inguards = 0 }
        inchecks && /^[ \t]*-[ \t]/ {
            c = $0; sub(/^[ \t]*-[ \t][ \t]*/, "", c)
            c = decomment(c)
            sub(/[ \t]+$/, "", c)
            c = unpair(c)
            if (c != "") checks[++nc] = c
            next
        }
        inchecks && /^[ \t]+[^ \t]/ { next }
        inchecks { inchecks = 0 }
        /^id:/     { s = $0; sub(/^id:[ \t]*/, "", s); s = decomment(s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); id = s; next }
        /^status:/ { s = $0; sub(/^status:[ \t]*/, "", s); s = decomment(s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); status = s; next }
        # The errata pointer, reported VERBATIM — id canonicalization is a
        # documented Rust-only extra (see the fixtures README).
        /^corrected-by:/ { s = $0; sub(/^corrected-by:[ \t]*/, "", s); s = decomment(s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); correctedby = s; next }
        /^title:/  { s = $0; sub(/^title:[ \t]*/, "", s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); title = s; next }
        /^guards:[ \t]*\[/ {
            s = $0; sub(/^guards:[ \t]*\[/, "", s); sub(/\][ \t]*(#.*)?$/, "", s)
            n = split(s, a, ",")
            for (i = 1; i <= n; i++) {
                g = a[i]
                gsub(/^[ \t"'\'']+/, "", g); gsub(/[ \t"'\'']+$/, "", g)
                if (g != "") guards[++ng] = g
            }
            next
        }
        /^guards:[ \t]*(#.*)?$/ { inguards = 1; inchecks = 0; next }
        /^checks:[ \t]*\[/ {
            s = $0; sub(/^checks:[ \t]*\[/, "", s); sub(/\][ \t]*(#.*)?$/, "", s)
            n = split(s, a, ",")
            for (i = 1; i <= n; i++) {
                c = a[i]
                gsub(/^[ \t"'\'']+/, "", c); gsub(/[ \t"'\'']+$/, "", c)
                if (c != "") checks[++nc] = c
            }
            next
        }
        /^checks:[ \t]*(#.*)?$/ { inchecks = 1; inguards = 0; next }
        END { flush() }
    ' "$@"
}

each_decision() { # $1 = root
    for f in "$1/$ZAVET_DIR"/decisions/D-*.md; do
        [ -e "$f" ] || continue
        printf '%s\n' "$f"
    done
}

# Parse spec-file frontmatter — MANY files in a single awk pass, same per-file
# reset discipline as frontmatter(). The slug is the filename minus .md (the
# filename convention is load-bearing: dira captures .zavet/specs/ by name).
#   spec_frontmatter meta  FILE...  -> "slug<TAB>origin<TAB>confidence<TAB>date<TAB>title"
#   spec_frontmatter paths FILE...  -> "slug<TAB>path glob" (one line per glob)
#   spec_frontmatter checks FILE... -> "slug<TAB>label<TAB>command" (same item
#       grammar as a decision's — one key, one dialect, two subjects)
spec_frontmatter() {
    mode=$1
    shift
    [ $# -gt 0 ] || return 0
    awk -v mode="$mode" '
        function slugof(f,    n, a, s) {
            n = split(f, a, "/"); s = a[n]; sub(/\.md$/, "", s); return s
        }
        # Inline `# comments` are allowed on structured lines (origin,
        # confidence, date, paths) — NEVER on title, which is free text.
        # Same dialect as dira-core::zavet, including a value that IS a
        # comment blanking to empty (so defaults apply).
        function decomment(s) {
            if (s ~ /^#/) return ""
            if (s !~ /^["'\'']/) sub(/[ \t]+#.*$/, "", s)
            return s
        }
        # Identical to the splitter in frontmatter() above: the grammar
        # belongs to the key, not to the record type.
        # Strip ONE matching pair of surrounding quotes, like the Rust
        # unquote. Deliberately not the independent-gsub form the guard and
        # path lists use: a command ending in a quote (runner --grep "A::b")
        # would lose it. sprintf(%c,34/39) keeps the quotes out of the awk
        # source, which lives inside a single-quoted shell string.
        function unpair(v,    f, l, dq, sq) {
            dq = sprintf("%c", 34); sq = sprintf("%c", 39)
            if (length(v) < 2) return v
            f = substr(v, 1, 1); l = substr(v, length(v), 1)
            if (f == l && (f == dq || f == sq)) return substr(v, 2, length(v) - 2)
            return v
        }
        function splitcheck(s,    i) {
            i = index(s, "::")
            if (i > 0) { _lbl = substr(s, 1, i - 1); _cmd = substr(s, i + 2) }
            else { _lbl = s; _cmd = s }
            gsub(/^[ \t]+/, "", _lbl); gsub(/[ \t]+$/, "", _lbl)
            gsub(/^[ \t]+/, "", _cmd); gsub(/[ \t]+$/, "", _cmd)
            if (_lbl == "") _lbl = _cmd
        }
        function flush(    i) {
            # `closed` gates emission: an unclosed --- fence is malformed and
            # yields nothing, matching the Rust parser.
            if (slug != "" && closed) {
                if (origin == "") origin = "reverse-engineered"
                if (conf == "") conf = "low"
                if (mode == "meta") print slug "\t" origin "\t" conf "\t" date "\t" title
                else if (mode == "checks") {
                    for (i = 1; i <= nc; i++) {
                        splitcheck(checks[i])
                        if (_cmd != "") print slug "\t" _lbl "\t" _cmd
                    }
                }
                else for (i = 1; i <= np; i++) print slug "\t" paths[i]
            }
            slug = ""; origin = ""; conf = ""; date = ""; title = ""; np = 0; nc = 0
            fm = 0; done = 0; closed = 0; inpaths = 0; inchecks = 0
        }
        FNR == 1 {
            flush()
            if ($0 == "---") { fm = 1; slug = slugof(FILENAME) } else done = 1
            next
        }
        done { next }
        fm && /^---[ \t]*$/ { done = 1; closed = 1; next }
        # Same block-list discipline as frontmatter(): item lines at any
        # indentation, tolerated indented strays, list ended (then parsed)
        # by the first non-indented non-item line.
        inpaths && /^[ \t]*-[ \t]/ {
            g = $0; sub(/^[ \t]*-[ \t][ \t]*/, "", g)
            g = decomment(g)
            sub(/[ \t]+$/, "", g)
            gsub(/^["'\'']/, "", g); gsub(/["'\''][ \t]*$/, "", g)
            if (g != "") paths[++np] = g
            next
        }
        inpaths && /^[ \t]+[^ \t]/ { next }
        inpaths { inpaths = 0 }
        inchecks && /^[ \t]*-[ \t]/ {
            c = $0; sub(/^[ \t]*-[ \t][ \t]*/, "", c)
            c = decomment(c)
            sub(/[ \t]+$/, "", c)
            c = unpair(c)
            if (c != "") checks[++nc] = c
            next
        }
        inchecks && /^[ \t]+[^ \t]/ { next }
        inchecks { inchecks = 0 }
        /^title:/      { s = $0; sub(/^title:[ \t]*/, "", s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); title = s; next }
        /^origin:/     { s = $0; sub(/^origin:[ \t]*/, "", s); s = decomment(s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); origin = s; next }
        /^confidence:/ { s = $0; sub(/^confidence:[ \t]*/, "", s); s = decomment(s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); conf = s; next }
        /^date:/       { s = $0; sub(/^date:[ \t]*/, "", s); s = decomment(s); gsub(/^["'\'']|["'\''][ \t]*$/, "", s); date = s; next }
        /^paths:[ \t]*\[/ {
            s = $0; sub(/^paths:[ \t]*\[/, "", s); sub(/\][ \t]*(#.*)?$/, "", s)
            n = split(s, a, ",")
            for (i = 1; i <= n; i++) {
                g = a[i]
                gsub(/^[ \t"'\'']+/, "", g); gsub(/[ \t"'\'']+$/, "", g)
                if (g != "") paths[++np] = g
            }
            next
        }
        /^paths:[ \t]*(#.*)?$/ { inpaths = 1; inchecks = 0; next }
        /^checks:[ \t]*\[/ {
            s = $0; sub(/^checks:[ \t]*\[/, "", s); sub(/\][ \t]*(#.*)?$/, "", s)
            n = split(s, a, ",")
            for (i = 1; i <= n; i++) {
                c = a[i]
                gsub(/^[ \t"'\'']+/, "", c); gsub(/[ \t"'\'']+$/, "", c)
                if (c != "") checks[++nc] = c
            }
            next
        }
        /^checks:[ \t]*(#.*)?$/ { inchecks = 1; inpaths = 0; next }
        END { flush() }
    ' "$@"
}


cmd_init() {
    top=$(repo_toplevel) || die "not inside a git repository"
    tpl="$(script_dir)/../templates"
    [ -d "$tpl" ] || die "templates not found at $tpl"
    dest="$top/$ZAVET_DIR"
    if [ -d "$dest" ]; then
        printf 'zavet: %s already exists — nothing to do\n' "$dest"
        return 0
    fi
    mkdir -p "$dest/decisions" "$dest/specs"
    for t in INDEX.md RULES.md glossary.md; do
        cp "$tpl/$t" "$dest/$t"
    done
    # Templates live OUTSIDE decisions/ and specs/ — nothing but real records
    # may sit in there (dira captures both directories by filename).
    cp "$tpl/decision.md" "$dest/.template.md"
    cp "$tpl/spec.md" "$dest/.spec-template.md"
    printf 'zavet: scaffolded %s\n' "$dest"
    printf 'zavet: next steps — edit RULES.md, then record your first decision (/zavet:decide)\n'
}

# The next free decision id.
#
# Scans the checked-out tree AND every decision filename that has ever existed
# on any ref. Looking only at the tree — as this used to — means two branches
# open at the same time always pick the SAME number: the collision surfaces
# only if INDEX.md happens to conflict, and a clean auto-merge lands two
# records sharing an id, where `decision-path` resolves by filename and one
# silently wins along with its guards.
#
# History, not just the current tree, because ids are append-only: a record
# that was written and later deleted has still burned its number, and reissuing
# it would orphan every `Refs: D-NNNN` trailer already in the log.
#
# Best-effort by construction — a branch this clone has never fetched is
# invisible here. `zavet check` is the guarantee (it runs in CI, where the base
# branch IS present and the merge result is what gets checked); this closes the
# common case so the guarantee rarely has to fire.
cmd_next_id() {
    root=$(zavet_root)
    max=$({
        each_decision "$root"
        git -C "$root" log --all --format= --name-only -- "$ZAVET_DIR/decisions" 2>/dev/null
    } | awk -F/ '{
        f = $NF
        sub(/^D-/, "", f)
        sub(/[-.].*$/, "", f)
        if (f ~ /^[0-9]+$/) { n = f + 0; if (n > max) max = n }
    } END { print max + 0 }')
    printf 'D-%04d\n' $((max + 1))
}

cmd_list() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/decisions/D-*.md
    [ -e "$1" ] || return 0
    frontmatter meta "$@"
}

cmd_guards() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/decisions/D-*.md
    [ -e "$1" ] || return 0
    frontmatter guards "$@"
}

# "id<TAB>label<TAB>command" for every decision, EVERY status. A guard is an
# enforcement surface and a superseded record enforces nothing; a check is a
# claim about how the record was verified, which survives supersession.
cmd_checks() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/decisions/D-*.md
    [ -e "$1" ] || return 0
    frontmatter checks "$@"
}

# "id<TAB>corrected-by" for decisions carrying an errata pointer.
cmd_errata() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/decisions/D-*.md
    [ -e "$1" ] || return 0
    frontmatter errata "$@"
}

# One "## <heading>" section of a decision, body only. The guard hook uses
# this to inject directives without the narrative Why when several records
# match one path.
cmd_section() {
    [ $# -ge 2 ] || die "usage: zavet section <id> <heading>"
    root=$(zavet_root)
    rel=$(cmd_decision_path "$1") || return 1
    awk -v want="$2" '
        # A "## " line opens a section; the next one closes it.
        /^## / {
            h = substr($0, 4)
            sub(/[ \t]+$/, "", h)
            inside = (h == want)
            next
        }
        inside { print }
    ' "$root/$rel"
}

cmd_match() {
    [ $# -ge 1 ] || die "usage: zavet match <repo-relative-path>"
    printf '%s\n' "$1" | cmd_match_batch
}

# Normalise one guard/spec glob into a `case` pattern — sets $norm (no
# subshell, hooks stay fork-free). `case` patterns do not treat "/"
# specially, so a single "*" already crosses directories; "**" collapses
# to "*" and a trailing "/" prefix-matches. The single normaliser shared
# by run_match and the audit pressure counter — one dialect, zero drift.
normalize_glob() {
    norm=$1
    while :; do
        case "$norm" in
            *"**"*)
                head=${norm%%"**"*}
                tail=${norm#*"**"}
                norm="${head}*${tail}"
                ;;
            *) break ;;
        esac
    done
    case "$norm" in */) norm="${norm}*" ;; esac
}

# Match repo-relative paths (stdin, one per line) against a "key<TAB>glob"
# table ($1); print each key whose globs cover at least one path (unique,
# table order). The table is normalised ONCE and matching is pure shell
# builtins. Shared by decision guards and spec coverage.
run_match() {
    table=$1
    tab=$(printf '\t')
    nl='
'
    set --
    while IFS="$tab" read -r id glob; do
        # shellcheck disable=SC2015
        [ -n "$id" ] && [ -n "$glob" ] || continue
        normalize_glob "$glob"
        set -- "$@" "${id}${tab}${norm}"
    done <<EOF
$table
EOF
    [ $# -gt 0 ] || return 0
    paths=""
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        paths="${paths}${rel}${nl}"
    done
    [ -n "$paths" ] || return 0
    seen=" "
    for entry; do
        id=${entry%%"$tab"*}
        pat=${entry#*"$tab"}
        case "$seen" in *" $id "*) continue ;; esac
        rest=$paths
        while [ -n "$rest" ]; do
            line=${rest%%"$nl"*}
            rest=${rest#*"$nl"}
            # shellcheck disable=SC2254
            case "$line" in $pat)
                printf '%s\n' "$id"
                seen="$seen$id "
                break
                ;;
            esac
        done
    done
}

cmd_match_batch() {
    run_match "$(cmd_guards)"
}

# Spec files are flat kebab-case <slug>.md; the sh glob never matches the
# dot-prefixed .spec-template.md, so no explicit template filter is needed.
cmd_specs() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/specs/*.md
    [ -e "$1" ] || return 0
    spec_frontmatter meta "$@"
}

# "slug<TAB>glob" for every spec — the coverage table spec-match runs against.
cmd_spec_paths() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/specs/*.md
    [ -e "$1" ] || return 0
    spec_frontmatter paths "$@"
}

# "slug<TAB>label<TAB>command" for every spec.
cmd_spec_checks() {
    root=$(zavet_root)
    set -- "$root/$ZAVET_DIR"/specs/*.md
    [ -e "$1" ] || return 0
    spec_frontmatter checks "$@"
}

cmd_spec_match() {
    run_match "$(cmd_spec_paths)"
}

# CI enforcement floor over a commit range — the machine equivalent of the
# guard-commit hook for environments without hooks. Every non-merge commit
# whose changed files match an active guard glob must carry a
# `Refs:`/`Supersedes:` trailer in its real message (hard fail); commits
# touching spec-covered paths without a `Spec:` trailer and without touching
# the covering spec file get a warning row (the hook is a nudge — CI must
# not be stricter). Matching runs through the exact same tables and
# run_match the hooks use, so CI semantics == hook semantics.
#
# stdout (TSV): violation<TAB>sha7<TAB>ids<TAB>subject
#               warn-spec<TAB>sha7<TAB>slugs<TAB>subject
# stderr: human summary. Exit 1 iff violations.
# Two records claiming one decision id.
#
# THE guarantee behind `next-id`'s best effort. Ids are chosen per branch from
# whatever that clone can see, so two branches open at once can both pick the
# same number; nothing surfaces it unless INDEX.md happens to conflict. In CI
# this runs against the merge result, where both records are present, so a
# collision fails the PR instead of landing and silently shadowing one record.
#
# Compared CANONICALLY (`D-16` and `D-0016` are one id, as dira reads them),
# so a shorthand filename cannot hide a collision from a string compare.
#
# A property of the TREE, not the commit range — like check_errata, every exit
# path of cmd_check runs it.
# Does ANY record claim this id? Deliberately not cmd_decision_path, which
# now refuses an ambiguous id: a duplicated target is a duplicate-id problem,
# and reporting it as a DANGLING pointer as well would name the wrong defect.
decision_exists() {
    root=$(zavet_root)
    dir="$root/$ZAVET_DIR/decisions"
    [ -f "$dir/$1.md" ] && return 0
    for f in "$dir/$1-"*.md; do
        [ -e "$f" ] && return 0
    done
    return 1
}

check_duplicate_ids() {
    root=$(zavet_root)
    dups=$(each_decision "$root" | awk -F/ '
        {
            f = $NF
            n = f
            sub(/^D-/, "", n)
            sub(/[-.].*$/, "", n)
            if (n !~ /^[0-9]+$/) next
            id = sprintf("D-%04d", n + 0)
            files[id] = (id in seen) ? files[id] " " f : f
            seen[id] = 1
            count[id]++
        }
        END { for (id in count) if (count[id] > 1) print id "\t" files[id] }
    ' | sort)
    [ -n "$dups" ] || return 0
    printf '%s\n' "$dups" | while IFS= read -r row; do
        [ -n "$row" ] || continue
        printf 'violation-duplicate-id\t%s\n' "$row"
    done
    n=$(printf '%s\n' "$dups" | grep -c .)
    printf 'zavet check: %s decision id(s) claimed by more than one record — rename the newer one and update its references.\n' "$n" >&2
    return 1
}

# Dangling errata: a `corrected-by` naming a record that does not exist.
#
# A property of the TREE, not of the commit range, so every exit path of
# cmd_check runs it — an empty range must still catch a typo'd pointer, which
# silently leaves the corrected record standing unmarked. Prints one row per
# bad pointer; returns 1 if any.
check_errata() {
    tab=$(printf '\t')
    n=0
    while IFS="$tab" read -r id target; do
        [ -n "$target" ] || continue
        # Subshell: these probes die on a miss, which would take the whole
        # check down instead of reporting one bad pointer.
        ( decision_exists "$target" ) >/dev/null 2>&1 && continue
        n=$((n + 1))
        printf 'violation-errata\t%s\t%s\tcorrected-by names a record that does not exist\n' "$id" "$target"
    done <<EOF
$(cmd_errata)
EOF
    [ "$n" -eq 0 ] && return 0
    printf 'zavet check: %s corrected-by pointer(s) name a record that does not exist — fix the id.\n' "$n" >&2
    return 1
}

cmd_check() {
    [ $# -ge 1 ] || die "usage: zavet check <rev-range>"
    top=$(repo_toplevel) || die "not inside a git repository"
    # No .zavet/ → pass: one blanket org workflow may run on every repo.
    if [ ! -d "$top/$ZAVET_DIR" ]; then
        printf 'zavet check: no %s/ — nothing to enforce\n' "$ZAVET_DIR" >&2
        return 0
    fi
    guards_table=$(cmd_guards)
    specs_table=$(cmd_spec_paths)
    if [ -z "$guards_table" ] && [ -z "$specs_table" ]; then
        rc=0
        check_duplicate_ids || rc=1
        check_errata || rc=1
        return "$rc"
    fi
    tab=$(printf '\t')
    nl='
'
    if ! all=$(git rev-list --no-merges "$@" --); then
        if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = "true" ]; then
            die "cannot resolve range in a shallow clone — checkout with fetch-depth: 0"
        fi
        die "cannot resolve range: $*"
    fi
    if [ -z "$all" ]; then
        rc=0
        check_duplicate_ids || rc=1
        check_errata || rc=1
        return "$rc"
    fi
    # Commits already carrying a trailer never violate — their diffs are
    # never even listed. Regexes verbatim from the guard-commit hook.
    refs_set="$nl$(git rev-list --no-merges -E --grep='(Refs|Supersedes):[[:space:]]*D-[0-9]+' "$@" --)$nl"
    spec_set="$nl$(git rev-list --no-merges -E --grep='Spec:[[:space:]]*[a-z0-9][a-z0-9-]*' "$@" --)$nl"
    violations=0
    warnings=0
    for sha in $all; do
        need_guard=1
        need_spec=1
        [ -n "$guards_table" ] || need_guard=0
        [ -n "$specs_table" ] || need_spec=0
        case "$refs_set" in *"$nl$sha$nl"*) need_guard=0 ;; esac
        case "$spec_set" in *"$nl$sha$nl"*) need_spec=0 ;; esac
        [ $need_guard -eq 1 ] || [ $need_spec -eq 1 ] || continue
        changed=$(git diff-tree -r --no-commit-id --name-only "$sha" --)
        [ -n "$changed" ] || continue
        info=""
        if [ $need_guard -eq 1 ]; then
            ids=$(printf '%s\n' "$changed" | run_match "$guards_table" | tr '\n' ' ')
            ids=${ids% }
            if [ -n "$ids" ]; then
                violations=$((violations + 1))
                info=$(git log -1 --format="%h${tab}%s" "$sha")
                printf 'violation\t%s\t%s\t%s\n' "${info%%"$tab"*}" "$ids" "${info#*"$tab"}"
            fi
        fi
        if [ $need_spec -eq 1 ]; then
            slugs=$(printf '%s\n' "$changed" | run_match "$specs_table")
            fresh=""
            for slug in $slugs; do
                # A commit that updates the covering spec itself needs no trailer.
                printf '%s\n' "$changed" | grep -qxF "$ZAVET_DIR/specs/$slug.md" && continue
                fresh="$fresh $slug"
            done
            fresh=${fresh# }
            if [ -n "$fresh" ]; then
                warnings=$((warnings + 1))
                [ -n "$info" ] || info=$(git log -1 --format="%h${tab}%s" "$sha")
                printf 'warn-spec\t%s\t%s\t%s\n' "${info%%"$tab"*}" "$fresh" "${info#*"$tab"}"
            fi
        fi
    done
    # Two counters, two messages: conflating them would report a tree-wide
    # authoring error as a count of commits, which is not actionable.
    # Two counters, two messages: conflating them would report a tree-wide
    # authoring error as a count of commits, which is not actionable.
    rc=0
    if [ "$violations" -gt 0 ]; then
        printf 'zavet check: %s commit(s) touch guarded paths without a Refs:/Supersedes: trailer — amend or rebase to add them.\n' "$violations" >&2
        rc=1
    fi
    # Both tree-wide checks always report, so one PR shows every problem it has
    # rather than surfacing them one merge at a time.
    check_duplicate_ids || rc=1
    check_errata || rc=1
    [ "$rc" -eq 0 ] || return 1
    if [ "$warnings" -gt 0 ]; then
        printf 'zavet check: %s commit(s) touch spec-covered paths without a Spec: trailer (warning only — keep specs current).\n' "$warnings" >&2
    fi
    return 0
}

cmd_decision_path() {
    [ $# -ge 1 ] || die "usage: zavet decision-path <id>"
    root=$(zavet_root)
    dir="$root/$ZAVET_DIR/decisions"
    # The D-NNNN[-slug].md filename convention is load-bearing (dira captures
    # that directory), so the id resolves by filename — no frontmatter parse.
    found=""
    n=0
    if [ -f "$dir/$1.md" ]; then
        found="$dir/$1.md"
        n=1
    fi
    for f in "$dir/$1-"*.md; do
        [ -e "$f" ] || continue
        [ -n "$found" ] || found=$f
        n=$((n + 1))
    done
    [ -n "$found" ] || die "no decision with id $1"
    # Two records claiming one id is a merge accident, not a choice. Picking
    # the first silently loses the other record AND its guards, so refuse.
    if [ "$n" -gt 1 ]; then
        die "id $1 is claimed by $n records — rename one (zavet check reports this)"
    fi
    printf '%s\n' "${found#"$root"/}"
}

# Report-only knowledge health sweep — deterministic facts as type-tagged
# TSV; /zavet:audit interprets them, this prints and judges nothing.
#
#   stale-spec<TAB>slug<TAB>n-commits<TAB>since-sha7
#   stale-decision<TAB>id<TAB>n-commits<TAB>since-sha7
#   guard-pressure<TAB>id<TAB>glob<TAB>files-matched<TAB>total-tracked
#
# Staleness anchors on the record FILE's last commit — the same last_commit
# semantics the dira daemon uses for wiki badges — never on the
# self-reported `date:`. Stale counting walks git with `:(glob)` pathspecs
# (daemon parity); guard pressure counts tracked files through
# normalize_glob + `case` (hook parity) — each check mirrors the consumer
# it feeds.
cmd_audit() {
    root=$(zavet_root) || exit 1
    tab=$(printf '\t')
    guards_table=$(cmd_guards)
    specs_table=$(cmd_spec_paths)
    checks_table=$(cmd_checks)

    # --- uncovered invariants: a record that tells an agent what to do but
    # never says how anyone would know it still holds. Reported, not failed —
    # plenty of real invariants are not mechanically checkable, and the point
    # is that the record SAYS so rather than leaving it assumed.
    for f in "$root/$ZAVET_DIR"/decisions/D-*.md; do
        [ -e "$f" ] || continue
        id=${f##*/}
        id=${id%%-*}
        id=${id%.md}
        grep -q '^## Agent directives' "$f" 2>/dev/null || continue
        printf '%s\n' "$checks_table" | awk -F '\t' -v i="$id" '$1 == i { found = 1 } END { exit !found }' && continue
        printf 'uncovered-invariant\t%s\t%s\n' "$id" "$(basename "$f")"
    done

    # --- long records: the capture bar is about what a reader could not
    # reconstruct, not about length — but a record that has grown into a
    # feature spec is one nobody re-reads, and guards inject it verbatim.
    for f in "$root/$ZAVET_DIR"/decisions/D-*.md; do
        [ -e "$f" ] || continue
        n=$(wc -l <"$f")
        n=$((n + 0))
        [ "$n" -gt 60 ] || continue
        id=${f##*/}
        id=${id%%-*}
        id=${id%.md}
        printf 'long-record\t%s\t%s\n' "$id" "$n"
    done

    # --- stale specs: commits touching a spec's paths since the spec file
    # itself last changed. Never-committed specs are skipped (fresh).
    for f in "$root/$ZAVET_DIR"/specs/*.md; do
        [ -e "$f" ] || continue
        slug=${f##*/}
        slug=${slug%.md}
        last=$(git -C "$root" log -1 --format=%H -- "$ZAVET_DIR/specs/$slug.md")
        [ -n "$last" ] || continue
        set --
        while IFS="$tab" read -r s g; do
            [ "$s" = "$slug" ] && [ -n "$g" ] && set -- "$@" ":(glob)$g"
        done <<EOF
$specs_table
EOF
        [ $# -gt 0 ] || continue
        n=$(git -C "$root" log --format=%H "$last..HEAD" -- "$@" | wc -l)
        n=$((n + 0))
        [ "$n" -gt 0 ] || continue
        printf 'stale-spec\t%s\t%s\t%s\n' "$slug" "$n" "$(git -C "$root" rev-parse --short "$last")"
    done

    [ -n "$guards_table" ] || return 0

    # --- stale decisions: commits touching a decision's guard globs since
    # the record file last changed — where code-vs-decision drift lives.
    ids=$(printf '%s\n' "$guards_table" | awk -F '\t' '!seen[$1]++ { print $1 }')
    for id in $ids; do
        rel=$(cmd_decision_path "$id" 2>/dev/null) || continue
        last=$(git -C "$root" log -1 --format=%H -- "$rel")
        [ -n "$last" ] || continue
        set --
        while IFS="$tab" read -r i g; do
            [ "$i" = "$id" ] && [ -n "$g" ] && set -- "$@" ":(glob)$g"
        done <<EOF
$guards_table
EOF
        [ $# -gt 0 ] || continue
        n=$(git -C "$root" log --format=%H "$last..HEAD" -- "$@" | wc -l)
        n=$((n + 0))
        [ "$n" -gt 0 ] || continue
        printf 'stale-decision\t%s\t%s\t%s\n' "$id" "$n" "$(git -C "$root" rev-parse --short "$last")"
    done

    # --- guard pressure: how many tracked files each active guard glob
    # covers right now. No threshold here — the agent judges breadth.
    files=$(git -C "$root" ls-files)
    total=$(printf '%s\n' "$files" | wc -l)
    total=$((total + 0))
    set --
    while IFS="$tab" read -r id glob; do
        # shellcheck disable=SC2015
        [ -n "$id" ] && [ -n "$glob" ] || continue
        set -- "$@" "${id}${tab}${glob}"
    done <<EOF
$guards_table
EOF
    for entry; do
        id=${entry%%"$tab"*}
        glob=${entry#*"$tab"}
        normalize_glob "$glob"
        pat=$norm
        matched=0
        while IFS= read -r fpath; do
            # shellcheck disable=SC2254
            case "$fpath" in $pat) matched=$((matched + 1)) ;; esac
        done <<EOF
$files
EOF
        printf 'guard-pressure\t%s\t%s\t%s\t%s\n' "$id" "$glob" "$matched" "$total"
    done
}

# Replace the lines between two markers in $1 with the contents of $4.
# BSD awk rejects newlines in -v strings, so the block travels as a file.
replace_block() { # $1 = index file, $2 = start marker, $3 = end marker, $4 = blockfile
    tmp="$1.tmp.$$"
    awk -v start="$2" -v end="$3" -v blockfile="$4" '
        $0 == start {
            print
            while ((getline line < blockfile) > 0) print line
            skipping = 1
            next
        }
        $0 == end { skipping = 0; print; next }
        !skipping { print }
    ' "$1" >"$tmp" && mv "$tmp" "$1"
}

# Run the checks bound to matching records and report PASS/FAIL.
#
# THE ONLY SUBCOMMAND THAT EXECUTES REPO CONTENT. It is never wired into a
# hook and never runs implicitly: cloning a repo and opening an agent session
# must not be able to run its commands. See SECURITY.md.
#
# Selection (all optional, AND-ed): --id / --spec pick one record, --paths
# resolves through the SAME run_match/spec-match tables the hooks and
# `zavet check` use (so CI semantics == hook semantics), --grep filters by
# label substring. No arguments runs everything.
#
# The command is opaque: exit 0 is pass, anything else is fail. Nothing here
# knows a test framework, and no output is parsed.
cmd_verify() {
    root=$(zavet_root)
    want_id=""; want_spec=""; grep_pat=""; paths=""; have_paths=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --id) shift; want_id=${1:-} ;;
            --spec) shift; want_spec=${1:-} ;;
            --grep) shift; grep_pat=${1:-} ;;
            --paths)
                shift
                have_paths=1
                while [ $# -gt 0 ]; do
                    case "$1" in --*) break ;; esac
                    paths="$paths$1
"
                    shift
                done
                continue
                ;;
            *) die "usage: zavet verify [--id D-NNNN] [--spec <slug>] [--paths f...] [--grep <substr>]" ;;
        esac
        shift
    done

    # Path selection resolves to the records covering those paths, then the
    # normal id/slug filter applies to the result.
    sel_ids=""; sel_slugs=""
    if [ "$have_paths" -eq 1 ]; then
        sel_ids=$(printf '%s' "$paths" | cmd_match_batch)
        sel_slugs=$(printf '%s' "$paths" | cmd_spec_match)
    fi

    # Materialize the candidate list FIRST, then loop reading from the file:
    # a `... | while` runs the loop in a subshell, where the tallies could not
    # escape. "kind<TAB>subject<TAB>label<TAB>command".
    tab=$(printf '\t')
    list="${TMPDIR:-/tmp}/zavet-verify-$$"
    { cmd_checks | sed "s/^/decision$tab/"
      cmd_spec_checks | sed "s/^/spec$tab/"
    } >"$list" 2>/dev/null

    ran=0
    fail=0
    while IFS="$tab" read -r kind subject label command; do
        [ -n "$command" ] || continue
        case "$kind" in
            decision)
                [ -z "$want_spec" ] || continue
                [ -z "$want_id" ] || [ "$want_id" = "$subject" ] || continue
                if [ "$have_paths" -eq 1 ]; then
                    printf '%s\n' "$sel_ids" | grep -qx -- "$subject" || continue
                fi
                ;;
            spec)
                [ -z "$want_id" ] || continue
                [ -z "$want_spec" ] || [ "$want_spec" = "$subject" ] || continue
                if [ "$have_paths" -eq 1 ]; then
                    printf '%s\n' "$sel_slugs" | grep -qx -- "$subject" || continue
                fi
                ;;
        esac
        if [ -n "$grep_pat" ]; then
            case "$label" in *"$grep_pat"*) ;; *) continue ;; esac
        fi
        ran=$((ran + 1))
        # Check output goes to stderr so stdout stays a clean PASS/FAIL table.
        # Exit 0 is pass; nothing about the output is inspected.
        if (cd "$root" && sh -c "$command" >&2 2>&1); then
            printf 'PASS\t%s\t%s\n' "$subject" "$label"
            cmd_emit check_passed "$subject" >/dev/null 2>&1 || true
        else
            printf 'FAIL\t%s\t%s\n' "$subject" "$label"
            cmd_emit check_failed "$subject" >/dev/null 2>&1 || true
            fail=$((fail + 1))
        fi
    done <"$list"
    rm -f "$list"

    if [ "$ran" -eq 0 ]; then
        printf 'zavet: no checks matched\n' >&2
        return 0
    fi
    printf 'zavet: %s check(s) run, %s failed\n' "$ran" "$fail" >&2
    [ "$fail" -eq 0 ] || return 1
    return 0
}
cmd_index() {
    root=$(zavet_root)
    idx="$root/$ZAVET_DIR/INDEX.md"
    [ -f "$idx" ] || die "missing $idx"
    blockfile="$idx.block.$$"
    cmd_list | sort | awk -F '\t' '{
        line = "- **" $1 "**"
        if ($3 != "") line = line " — " $3
        line = line " (" $2 ")"
        print line
    }' >"$blockfile"
    replace_block "$idx" "$MARK_START" "$MARK_END" "$blockfile"
    rm -f "$blockfile"
    # The specs block regenerates only when its markers exist — repos
    # scaffolded before the spec layer keep working untouched.
    if grep -qF "$MARK_SPECS_START" "$idx" 2>/dev/null; then
        blockfile="$idx.specs.$$"
        cmd_specs | sort | awk -F '\t' '{
            line = "- **" $1 "**"
            if ($5 != "") line = line " — " $5
            meta = $2 ", " $3
            if ($4 != "") meta = meta ", " $4
            print line " (" meta ")"
        }' >"$blockfile"
        replace_block "$idx" "$MARK_SPECS_START" "$MARK_SPECS_END" "$blockfile"
        rm -f "$blockfile"
    fi
    printf 'zavet: index updated\n'
}

# JSON-escape a string. Multi-line safe (deny reasons embed decision bodies),
# no jq required — awk is already a hard dependency. A per-character loop
# sidesteps gsub replacement-escape differences between BWK awk and gawk.
json_escape() {
    printf '%s' "$1" | awk '
        BEGIN { ORS = "" }
        NR > 1 { print "\\n" }
        {
            n = length($0)
            for (i = 1; i <= n; i++) {
                c = substr($0, i, 1)
                if (c == "\\") print "\\\\"
                else if (c == "\"") print "\\\""
                else if (c == "\t") print "\\t"
                else if (c == "\r") print "\\r"
                else print c
            }
        }
    '
}

# Print the PreToolUse permission-deny JSON the guard hooks emit. Centralised
# here so the hooks do not each need jq just to build a static envelope.
cmd_deny() {
    [ $# -ge 1 ] || die "usage: zavet deny <reason>"
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' \
        "$(json_escape "$1")"
}

cmd_emit() {
    [ $# -ge 2 ] || die "usage: zavet emit <kind> <decision-id> [file-path]"
    command -v dira >/dev/null 2>&1 || return 0
    kind=$1
    id=$2
    file=${3:-}
    cwd=$(repo_toplevel || pwd)
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    json=$(printf '{"v":1,"kind":"%s","decision_id":"%s","file_path":"%s","cwd":"%s","ts":"%s"}' \
        "$(json_escape "$kind")" "$(json_escape "$id")" "$(json_escape "$file")" \
        "$(json_escape "$cwd")" "$ts")
    # Fire-and-forget: a missing daemon or an older dira must never slow a hook.
    printf '%s' "$json" | dira zavet emit >/dev/null 2>&1 &
    return 0
}

# The version contract `dira zavet install` reads to report plugin version
# and (advisory only, never gating — see ZAVET_MIN_DIRA above) surface
# skew. Bare form for humans/scripts, --json for machine consumers.
cmd_version() {
    v=$(plugin_version)
    case "${1:-}" in
        --json)
            printf '{"v":1,"plugin":"zavet","version":"%s","emit_schema":%s,"min_dira":"%s"}\n' \
                "$(json_escape "$v")" "$ZAVET_EMIT_SCHEMA" "$(json_escape "$ZAVET_MIN_DIRA")"
            ;;
        "") printf '%s\n' "$v" ;;
        *) die "usage: zavet version [--json]" ;;
    esac
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1
shift
case "$cmd" in
    init) cmd_init "$@" ;;
    root) zavet_root ;;
    next-id) cmd_next_id ;;
    list) cmd_list ;;
    guards) cmd_guards ;;
    match) cmd_match "$@" ;;
    match-batch) cmd_match_batch ;;
    specs) cmd_specs ;;
    spec-paths) cmd_spec_paths ;;
    spec-match) cmd_spec_match ;;
    checks) cmd_checks ;;
    spec-checks) cmd_spec_checks ;;
    errata) cmd_errata ;;
    section) cmd_section "$@" ;;
    verify) cmd_verify "$@" ;;
    check) cmd_check "$@" ;;
    audit) cmd_audit ;;
    decision-path) cmd_decision_path "$@" ;;
    index) cmd_index ;;
    deny) cmd_deny "$@" ;;
    emit) cmd_emit "$@" ;;
    version | --version | -V) cmd_version "$@" ;;
    help | -h | --help) usage ;;
    *)
        usage
        exit 1
        ;;
esac
